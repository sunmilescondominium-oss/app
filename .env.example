# =============================================================================
# Sun Miles PMS — environment template. Copy to .env.local and fill real values.
# .env.local is git-ignored; never commit real keys.
# =============================================================================

# ---- Supabase (public — safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Server-only secrets (NEVER exposed to the browser) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string — used ONLY by the migration/seed scripts.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# Use the "Direct connection" (port 5432) or "Session pooler" URI.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# ---- Integrations (server-only) ----
# TODO(client-confirm): n8n Computation Agent endpoint + request/response schema.
N8N_COMPUTATION_WEBHOOK_URL=
RESEND_API_KEY=
RESEND_FROM=Sun Miles Property Management <onboarding@resend.dev>
ALERT_EMAIL_TO=                        # comma-separated recipients for alerts
N8N_ALERT_WEBHOOK_URL=                 # only if ALERT_EMAIL_DRIVER=n8n
CRON_SECRET=                           # shared secret for /api/cron/* (Vercel Cron sends it automatically)

# Public site origin — used to build absolute links (e.g. password-reset emails).
# Set in Vercel (production) to the live domain. Leave EMPTY locally so dev falls
# back to the request host (localhost).
NEXT_PUBLIC_SITE_URL=                  # e.g. https://app.sunmilescondo.com

# ---- Gmail / SMTP (only if ALERT_EMAIL_DRIVER=smtp) ----
# Sender = the Sun Miles Gmail. SMTP_PASS must be a Gmail *App Password*
# (16 chars, created at https://myaccount.google.com/apppasswords with 2FA on) —
# NOT the normal Gmail password. Never commit the real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sunmilescondominium@gmail.com
SMTP_PASS=                             # Gmail App Password (put the real one only in .env.local / Vercel)
SMTP_FROM=Sun Miles Property Management <sunmilescondominium@gmail.com>

# ---- Driver switches (config-only; flipping needs no redeploy) ----
ALERT_EMAIL_DRIVER=resend      # resend (default) | n8n | smtp (Gmail)
COMPUTATION_DRIVER=local       # local (default until n8n schema provided) | n8n

# ---- Bootstrap owner/admin (seed script only) ----
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=change-me-to-a-strong-password
BOOTSTRAP_OWNER_DISPLAY_LABEL=Owner
